{
  "framework": "create-react-app",
  "buildCommand": "CI=false npm run build --prefix frontend",
  "outputDirectory": "frontend/build",
  "installCommand": "npm install && npm install --prefix frontend && npm install --prefix backend",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "backend/node_modules/swagger-ui-dist/{swagger-ui.css,swagger-ui-bundle.js,swagger-ui-standalone-preset.js}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
