{
  "name": "tutoring-platform-backend",
  "version": "1.0.0",
  "description": "Backend API for tutoring platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node seed-admin.js",
    "test": "node --test tests/accounts.test.js tests/sessions.test.js tests/mainCompatibility.test.js tests/userPrivacy.test.js tests/performance.test.js tests/appeals.test.js tests/changePassword.test.js tests/performanceLab.test.js tests/performanceCodeLab.test.js tests/moderation.test.js",
    "test:moderation:integration": "node --test tests/moderation.integration.test.js",
    "test:filters:integration": "node --test tests/classFilters.integration.test.js",
    "test:filters:lab": "node scripts/test-class-filters.js",
    "test:appeals:integration": "node --test tests/appeals.integration.test.js",
    "perf:benchmark": "node scripts/benchmark-api.js",
    "perf:indexes": "node scripts/api-indexes.js",
    "perf:lab": "node scripts/performance-lab.js",
    "perf:code:lab": "node scripts/performance-code-lab.js",
    "test:perf:lab": "node --test tests/performanceLab.test.js"
  },
  "keywords": ["tutoring", "education", "api"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "dotenv": "^16.0.3",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "express-validator": "^7.0.0",
    "axios": "^1.3.4"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
